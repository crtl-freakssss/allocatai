# ==============================================================================
# AllocateAI Backend - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit production credentials or secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
DEBUG=true

# API Routing
API_PREFIX=/api
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/allocateai

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Docker Compose Database Settings (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allocateai
POSTGRES_PORT=5432
